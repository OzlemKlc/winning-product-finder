    {
      "parameters": {
        "jsCode": "// HTML to Plain Text Converter for n8n Code Node\nconst htmlContent = $input.first().json.data\n\nif (!htmlContent) {\n  return [{ json: { error: \"No HTML content found in input\" } }];\n}\n\nfunction htmlToPlainText(html) {\n  let text = html;\n  text = text.replace(/<script[^>]*>[\\s\\S]*?<\\/script>/gi, '');\n  text = text.replace(/<style[^>]*>[\\s\\S]*?<\\/style>/gi, '');\n  text = text.replace(/<\\/?(div|p|br|h[1-6]|li|tr)[^>]*>/gi, '\\n');\n  text = text.replace(/<li[^>]*>/gi, '- ');\n  text = text.replace(/<[^>]*>/g, '');\n  const entityMap = {\n    '&amp;': '&',\n    '&lt;': '<',\n    '&gt;': '>',\n    '&quot;': '\"',\n    '&#39;': \"'\",\n    '&apos;': \"'\",\n    '&nbsp;': ' '\n  };\n  for (const [entity, char] of Object.entries(entityMap)) {\n    text = text.replace(new RegExp(entity, 'g'), char);\n  }\n  text = text.replace(/&#(\\d+);/g, (match, dec) => String.fromCharCode(dec));\n  text = text.replace(/&#x([0-9A-Fa-f]+);/g, (match, hex) => String.fromCharCode(parseInt(hex, 16)));\n  text = text.replace(/\\n\\s*\\n/g, '\\n\\n');\n  text = text.replace(/[ \\t]+/g, ' ');\n  text = text.trim();\n  return text;\n}\n\ntry {\n  const plainText = htmlToPlainText(htmlContent);\n  return [{ json: { originalHtml: htmlContent, plainText: plainText, characterCount: plainText.length, wordCount: plainText.split(/\\s+/).filter(word => word.length > 0).length, success: true } }];\n} catch (error) {\n  return [{ json: { error: `Failed to convert HTML to text: ${error.message}`, originalHtml: htmlContent, success: false } }];\n}"
      },
