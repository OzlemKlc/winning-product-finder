# ==========================================================================
# Winning Product Finder — ortam değişkenleri örneği
# Bu dosyayı `.env` olarak kopyala ve değerleri doldur.  (`.env` ASLA commit edilmez)
# Hiçbir değer verilmese bile uygulama DEMO modda + in-memory DB ile çalışır.
# ==========================================================================

# --- Sunucu ---
PORT=4545
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# --- Canlı mod (Apify) ---
# https://console.apify.com → Settings → API. Sunucuda tanımlıysa arayüzde token girmeye gerek kalmaz.
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxx
# APIFY_ACTOR=curious_coder~facebook-ads-library-scraper
# APIFY_TIMEOUT_MS=90000
# APIFY_DEFAULT_COUNT=12

# --- AI analiz (opsiyonel — Anthropic/Claude, tool-calling) ---
# Verilirse arama sonrası ilk N ürünün reklam metni analiz edilir (niş/hook/açı).
# Anahtar yoksa özellik sessizce kapanır; arama yine çalışır.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5
# LLM_ANALYZE_TOP_N=5

# --- Kalıcılık (opsiyonel) ---
# Aşağıdakilerden biri verilirse arama geçmişi Postgres'e yazılır; yoksa in-memory.
# Supabase: Project Settings → Database → Connection string (URI)
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# DATABASE_SSL=true

# Alternatif Supabase bağlantısı (proje bilgileriyle):
# SUPABASE_URL=https://[PROJECT-REF].supabase.co
# SUPABASE_SERVICE_KEY=eyJ...   # service_role veya anon key (sunucu tarafı)

# --- Skorlama ağırlıkları (opsiyonel — toplam 100 olmalı) ---
# SCORE_W_LONGEVITY=45
# SCORE_W_ADSCALE=30
# SCORE_W_RATING=15
# SCORE_W_FRESHNESS=10
