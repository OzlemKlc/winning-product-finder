# Winning Product Finder environment variables
# Copy this file to .env. The application works in demo mode with in-memory storage when left empty.

NODE_ENV=development
PORT=4545
HOST=0.0.0.0
LOG_LEVEL=info
MAX_BODY_BYTES=1000000

# Live Apify source
# https://console.apify.com -> Settings -> API
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxx
# APIFY_ACTOR=curious_coder~facebook-ads-library-scraper
# APIFY_TIMEOUT_MS=90000
# APIFY_DEFAULT_COUNT=12

# Optional OpenAI analysis for the highest-ranked products
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-6.1-sol
# OPENAI_TIMEOUT_MS=30000
# LLM_ANALYZE_TOP_N=5

# Optional persistence. Without these values, the in-memory repository is used.
# DATABASE_URL=postgresql://user:password@host:5432/database
# DATABASE_SSL=true

# Alternative Supabase connection details
# SUPABASE_URL=https://project.supabase.co
# SUPABASE_SERVICE_KEY=eyJ...

# Optional scoring weights; the total should remain 100.
# SCORE_W_LONGEVITY=45
# SCORE_W_ADSCALE=30
# SCORE_W_RATING=15
# SCORE_W_FRESHNESS=10
# SCORE_CAP_DAYS=365
# SCORE_CAP_ADS=60

# Number of top products that receive deterministic UGC briefs.
# UGC_BRIEF_TOP_N=5
